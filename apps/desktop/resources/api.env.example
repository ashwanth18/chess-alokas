# Chess Alokas — desktop API sidecar environment
# Copied to %APPDATA%\Chess Alokas\api.env on first launch.
# Edit the userData copy (not this example) with your real secrets.

PORT=3001
HOST=127.0.0.1

# Leave DATABASE_URL unset for in-memory API (offline demo; sync needs Postgres).
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Certificate PDFs in Supabase Storage (private bucket: certificates)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Optional email
# RESEND_API_KEY=
# RESEND_FROM=Chess Alokas <certificates@yourdomain.com>
