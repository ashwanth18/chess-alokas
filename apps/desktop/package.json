{
  "name": "@chess-alokas/desktop",
  "version": "0.1.26",
  "private": true,
  "description": "Chess Alokas Electron desktop shell",
  "author": "Chess Alokas",
  "main": "out/main.js",
  "type": "module",
  "desktopName": "Chess-Alokas",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "dev": "cross-env ELECTRON_DEV=1 pnpm run build:main && electron .",
    "build": "pnpm run build:main",
    "dist": "pnpm run build:main && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3"
  }
}
