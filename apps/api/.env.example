# Leave DATABASE_URL unset to use in-memory store (local demo)

PORT=3001
HOST=0.0.0.0

# Supabase database password (Project Settings → Database)
SUPABASE_DB_PASSWORD=your-password-here

# Transaction pooler URI (port 6543) — use SUPABASE_DB_PASSWORD above
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:your-password-here@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Resend (digital certificate email)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Chess Alokas <certificates@yourdomain.com>

# Supabase Storage for digital certificate PDFs (Issue digital)
# Project Settings → API → use the secret key (sb_secret_...) or legacy service_role
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # optional alias for older dashboards
# SUPABASE_ANON_KEY=eyJ...or_sb_publishable_...  # JWT verify for /me + requireAuth
# AUTH_DISABLED=1  # local demo only — skips JWT checks
# Bucket: certificates (private). Falls back to local disk if unset.

# Local PDF storage directory (defaults to apps/api/data/certificates)
# CERTIFICATES_DIR=

# Sentry (free Developer plan — errors + light tracing; no Session Replay)
# SENTRY_DSN=https://....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=api@0.1.0
