# API
VITE_API_URL=http://localhost:3001

# Supabase Auth (publishable / anon key only — never the secret key)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...or_sb_publishable_...

# Optional: desktop download links (defaults to ashwanth18/chess-alokas GitHub Releases)
# VITE_GITHUB_RELEASES_API=https://api.github.com/repos/ashwanth18/chess-alokas/releases/latest
# VITE_DESKTOP_RELEASES_BASE=https://github.com/ashwanth18/chess-alokas/releases/latest

# Sentry (free Developer plan — errors + light tracing only; no Session Replay)
# VITE_SENTRY_DSN=https://....ingest.sentry.io/...
# VITE_SENTRY_ENVIRONMENT=production
# VITE_APP_VERSION=web@0.1.0
# VITE_SENTRY_ORG_URL=https://sentry.io/organizations/YOUR_ORG/issues/
# Build-time source maps (optional; never commit the auth token):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
