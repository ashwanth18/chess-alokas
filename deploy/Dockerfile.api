# Chess Alokas API — production image for Dokploy
# pnpm 11 needs Node 22+ (ERR_UNKNOWN_BUILTIN_MODULE on Node 20)
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/desktop/package.json apps/desktop/
COPY packages/shared/package.json packages/shared/
COPY packages/pairing-engine/package.json packages/pairing-engine/
COPY packages/certificates/package.json packages/certificates/
RUN pnpm install --frozen-lockfile
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm --filter @chess-alokas/api run build:desktop

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001
COPY --from=build /app/apps/api/desktop-bundle ./
# Official FIDE Dutch engine (bbpPairings v6.0.0, Apache-2.0).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar gzip \
  && mkdir -p /app/vendor/bbp-pairings/linux-x64 \
  && curl -fsSL "https://github.com/BieremaBoyzProgramming/bbpPairings/releases/download/v6.0.0/bbpPairings-v6.0.0-x86_64-pc-linux.tar.gz" \
    -o /tmp/bbp.tar.gz \
  && tar -xzf /tmp/bbp.tar.gz -C /tmp \
  && find /tmp -type f \( -name 'bbpPairings.exe' -o -name 'bbpPairings' \) -exec cp {} /app/vendor/bbp-pairings/linux-x64/bbpPairings.exe \; \
  && chmod +x /app/vendor/bbp-pairings/linux-x64/bbpPairings.exe \
  && test -s /app/vendor/bbp-pairings/linux-x64/bbpPairings.exe \
  && rm -rf /tmp/bbp.tar.gz /tmp/bbpPairings* \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*
ENV BBP_PAIRINGS_PATH=/app/vendor/bbp-pairings/linux-x64/bbpPairings.exe
EXPOSE 3001
CMD ["node", "index.js"]
